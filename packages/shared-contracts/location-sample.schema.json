{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future single coarse location sample (not exposed as an API)",
  "description": "Unrouted Phase 4C foundation. Requires a future explicit location-collection-v1 activation; sharing-v1 preferences never authorize ingestion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["consent_version", "recorded_at", "latitude", "longitude", "accuracy_meters"],
  "properties": {
    "consent_version": {"type": "integer", "minimum": 1},
    "recorded_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "format": "date-time"},
    "latitude": {"type": "number", "minimum": -90, "maximum": 90},
    "longitude": {"type": "number", "minimum": -180, "maximum": 180},
    "accuracy_meters": {"type": "integer", "minimum": 0, "maximum": 100000}
  }
}