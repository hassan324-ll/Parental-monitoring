{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future cumulative daily usage snapshot (no public API)",
  "description": "Internal foundation only. Requires future usage-collection-v1 activation, never sharing-v1 preferences. Totals cover max(UTC day start, current grant) through recorded_until, with at most one foreground app per second.",
  "type": "object",
  "additionalProperties": false,
  "required": ["consent_version", "day", "recorded_until", "apps"],
  "properties": {
    "consent_version": {"type": "integer", "minimum": 1},
    "day": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "recorded_until": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "apps": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["package_name", "duration_seconds"],
        "properties": {
          "package_name": {"type": "string", "maxLength": 150, "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"},
          "duration_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
        }
      }
    }
  }
}